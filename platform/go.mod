// Package platform is the shared runtime spine of every service: config,
// logging, tracing, metrics, gRPC server and client wiring, error mapping and
// money arithmetic. It holds no domain logic.
module github.com/danila-kuryakin/banking_mini_cores/platform

go 1.25.7

require (
	github.com/joho/godotenv v1.5.1
	github.com/spf13/viper v1.21.0
	google.golang.org/grpc v1.83.1
)

require (
	github.com/fsnotify/fsnotify v1.9.0 // indirect
	github.com/go-viper/mapstructure/v2 v2.4.0 // indirect
	github.com/pelletier/go-toml/v2 v2.2.4 // indirect
	github.com/rogpeppe/go-internal v1.14.1 // indirect
	github.com/sagikazarmark/locafero v0.11.0 // indirect
	github.com/sourcegraph/conc v0.3.1-0.20240121214520-5f936abd7ae8 // indirect
	github.com/spf13/afero v1.15.0 // indirect
	github.com/spf13/cast v1.10.0 // indirect
	github.com/spf13/pflag v1.0.10 // indirect
	github.com/subosito/gotenv v1.6.0 // indirect
	go.opentelemetry.io/otel v1.45.0 // indirect
	go.opentelemetry.io/otel/sdk/metric v1.45.0 // indirect
	go.yaml.in/yaml/v3 v3.0.4 // indirect
	golang.org/x/net v0.57.0 // indirect
	golang.org/x/sys v0.47.0 // indirect
	golang.org/x/text v0.40.0 // indirect
	google.golang.org/genproto/googleapis/rpc v0.0.0-20260819154853-08b0e4226688 // indirect
	google.golang.org/protobuf v1.36.12 // indirect
)

// The modules of this monorepo are never published. The replace directives
// keep `go build` and `go mod tidy` working inside a single module directory,
// independently of go.work, which is what the Docker build relies on.
