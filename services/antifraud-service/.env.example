# --- контейнер Postgres из docker-compose.yml ---
POSTGRES_USER=banking_antifraud
POSTGRES_PASSWORD=123
POSTGRES_DB=banking_antifraud
POSTGRES_PORT=5457

# --- подключение сервиса к этой же базе (перекрывает configs/config.yml) ---
DATABASE_HOST=localhost
DATABASE_PORT=5457
DATABASE_USER=banking_antifraud
DATABASE_PASSWORD=123
DATABASE_DBNAME=banking_antifraud
DATABASE_SSL_MODE=disable

# --- валюты, список тот же, что у account-service и ledger-service ---
CURRENCIES=RUB,USD,EUR

# --- Kafka из services/kafka-service ---
KAFKA_BROKERS=localhost:29092
KAFKA_TOPICS=ledger.events
KAFKA_GROUP_ID=antifraud
KAFKA_START_OFFSET=first

# --- повторы обработки события ---
CONSUMER_MIN_BACKOFF=500ms
CONSUMER_MAX_BACKOFF=30s

# --- порт сервиса ---
SERVER_PORT=50057
