# --- порты гейтвея ---
# SERVER_* - REST наружу, GRPC_CLIENT_* - gRPC-сервер health-проверок.
# Rest сервер
SERVER_HOST=localhost
SERVER_PORT=8080
# Сервер gRPC для health check
GRPC_CLIENT_HOST=localhost
GRPC_CLIENT_PORT=50059

# --- адреса сервисов, куда ходит гейтвей ---
# Должны совпадать с SERVER_PORT соответствующего сервиса. Config.Validate
# требует непустой адрес для каждого upstream, но пустое значение здесь его не
# уронит: AllowEmptyEnv у viper выключен, и пустая переменная считается
# незаданной - подставится значение из configs/config.yml.
UPSTREAMS_AUTH=localhost:50051
UPSTREAMS_CUSTOMER=localhost:50052
UPSTREAMS_KYC=localhost:50053
UPSTREAMS_FILESTORE=localhost:50054
UPSTREAMS_ACCOUNT=localhost:50055
UPSTREAMS_LEDGER=localhost:50056
UPSTREAMS_ANTIFRAUD=localhost:50057
UPSTREAMS_NOTIFICATION=localhost:50058

# --- проверка токенов ---
# Гейтвей проверяет подписи локально по JWKS.
# Хост и порт - это JWKS_PORT auth-service, не его SERVER_PORT.
JWKS_URL=http://localhost:8081/.well-known/jwks.json
JWKS_REFRESH_INTERVAL=5m

# --- таймауты ---
# REQUEST_TIMEOUT - на один вызов к нижнему сервису, SHUTDOWN_TIMEOUT - на
# ожидание открытых соединений при остановке.
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=5s
