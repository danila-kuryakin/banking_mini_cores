# --- контейнер Postgres из docker-compose.yml ---
POSTGRES_USER=banking_kyc
POSTGRES_PASSWORD=123
POSTGRES_DB=banking_kyc
POSTGRES_PORT=5453

# --- подключение сервиса к этой же базе (перекрывает configs/config.yml) ---
DATABASE_HOST=localhost
DATABASE_PORT=5453
DATABASE_USER=banking_kyc
DATABASE_PASSWORD=123
DATABASE_DBNAME=banking_kyc
DATABASE_SSL_MODE=disable

# --- соседние сервисы ---
UPSTREAMS_CUSTOMER=localhost:50052
UPSTREAMS_FILESTORE=localhost:50054

# --- Kafka из services/kafka-service ---
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC=kyc.events

# --- публикация outbox ---
OUTBOX_INTERVAL=1s
OUTBOX_BATCH_SIZE=100

# --- порт сервиса ---
# Если gRPC порт меняется, то нужно править upstreams.kyc в конфиге гейтвея.
SERVER_PORT=50053
