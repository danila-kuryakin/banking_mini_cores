# --- контейнер Postgres из docker-compose.yml ---
POSTGRES_USER=banking_ledger
POSTGRES_PASSWORD=123
POSTGRES_DB=banking_ledger
POSTGRES_PORT=5456

# --- подключение сервиса к этой же базе (перекрывает configs/config.yml) ---
DATABASE_HOST=localhost
DATABASE_PORT=5456
DATABASE_USER=banking_ledger
DATABASE_PASSWORD=123
DATABASE_DBNAME=banking_ledger
DATABASE_SSL_MODE=disable

# --- валюты, список тот же, что у account-service ---
CURRENCIES=RUB,USD,EUR

# --- Kafka из services/kafka-service ---
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC=ledger.events

# --- публикация outbox ---
OUTBOX_INTERVAL=1s
OUTBOX_BATCH_SIZE=100

# --- соседние сервисы ---
UPSTREAMS_ACCOUNT=localhost:50055

# --- порт сервиса ---
SERVER_PORT=50056
