# --- контейнеры Postgres и MinIO из docker-compose.yml ---
POSTGRES_USER=banking_filestore
POSTGRES_PASSWORD=123
POSTGRES_DB=banking_filestore
POSTGRES_PORT=5454
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- подключение сервиса к этой же базе (перекрывает configs/config.yml) ---
DATABASE_HOST=localhost
DATABASE_PORT=5454
DATABASE_USER=banking_filestore
DATABASE_PASSWORD=123
DATABASE_DBNAME=banking_filestore
DATABASE_SSL_MODE=disable

# --- подключение сервиса к этому же хранилищу ---
MINIO_CONFIG_ENDPOINT=localhost:9000
MINIO_CONFIG_ACCESS_KEY=minioadmin
MINIO_CONFIG_SECRET_KEY=minioadmin
MINIO_CONFIG_BUCKET_NAME=kyc-filestore
MINIO_CONFIG_USE_SSL=false

# --- порт сервиса ---
# Если gRPC порт меняется, то нужно править upstreams.filestore в конфиге гейтвея.
SERVER_PORT=50054
