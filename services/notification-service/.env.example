# --- контейнер Postgres из docker-compose.yml ---
POSTGRES_USER=banking_notification
POSTGRES_PASSWORD=123
POSTGRES_DB=banking_notification
POSTGRES_PORT=5458

# --- подключение сервиса к этой же базе (перекрывает configs/config.yml) ---
DATABASE_HOST=localhost
DATABASE_PORT=5458
DATABASE_USER=banking_notification
DATABASE_PASSWORD=123
DATABASE_DBNAME=banking_notification
DATABASE_SSL_MODE=disable

# --- Kafka из services/kafka-service: что слушаем и куда откладываем непрочитанное ---
KAFKA_BROKERS=localhost:29092
KAFKA_TOPICS=ledger.events,kyc.events
KAFKA_TOPIC=notification.dlq
KAFKA_GROUP_ID=notification
KAFKA_START_OFFSET=first

# --- повторы обработки до ухода в DLQ ---
CONSUMER_MAX_ATTEMPTS=5
CONSUMER_MIN_BACKOFF=500ms
CONSUMER_MAX_BACKOFF=30s

# --- порт сервиса ---
SERVER_PORT=50058
