# Брокеры Kafka через запятую. Переопределяет config.yml.
# Пустое значение НЕ отключает шину: viper считает пустую переменную
# незаданной, и в силе останется config.yml. Чтобы поднять сервис без Kafka,
# закомментируйте brokers в configs/config.yml.
KAFKA_BROKERS=localhost:29092
KAFKA_TOPICS=auth.events,customer.events,kyc.events,ledger.events
