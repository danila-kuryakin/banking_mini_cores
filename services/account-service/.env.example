# --- контейнер Postgres из docker-compose.yml ---
POSTGRES_USER=banking_account
POSTGRES_PASSWORD=123
POSTGRES_DB=banking_account
POSTGRES_PORT=5455

# --- подключение сервиса к этой же базе (перекрывает configs/config.yml) ---
DATABASE_HOST=localhost
DATABASE_PORT=5455
DATABASE_USER=banking_account
DATABASE_PASSWORD=123
DATABASE_DBNAME=banking_account
DATABASE_SSL_MODE=disable

# --- валюты и номер счёта ---
CURRENCIES=RUB,USD,EUR
DEFAULT_CURRENCY=RUB
ACCOUNT_NUMBER_BALANCE_PREFIX=40817

# --- соседние сервисы ---
UPSTREAMS_CUSTOMER=localhost:50052
UPSTREAMS_LEDGER=localhost:50056

# --- порт сервиса ---
SERVER_PORT=50055
