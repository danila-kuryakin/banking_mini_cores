# --- контейнер Postgres из docker-compose.yml ---
POSTGRES_USER=banking_auth
POSTGRES_PASSWORD=123
POSTGRES_DB=banking_auth
POSTGRES_PORT=5451

# --- подключение сервиса к этой же базе (перекрывает configs/config.yml) ---
DATABASE_HOST=localhost
DATABASE_PORT=5451
DATABASE_USER=banking_auth
DATABASE_PASSWORD=123
DATABASE_DBNAME=banking_auth
DATABASE_SSL_MODE=disable

# --- администратор по умолчанию ---
# Создаётся при старте, если его ещё нет. Пустое значение - учётная запись не
# создаётся вовсе. Существующему пользователю пароль не меняется: чтобы завести
# админа заново с другим паролем, запись нужно удалить из БД.
ADMIN_EMAIL=admin@banking.local
ADMIN_PASSWORD=

# --- адреса сервисов, куда ходит auth-service ---
UPSTREAMS_CUSTOMER=localhost:50052

# --- порты сервиса ---
# SERVER_PORT - gRPC, JWKS_PORT - HTTP с публичным ключом. Гейтвей ходит на оба,
# так что менять их нужно вместе с upstreams и jwks_url в его конфиге.
SERVER_PORT=50051
JWKS_PORT=8081

# --- ключ подписи JWT ---
# Файла нет - сервис создаст его при первом запуске. Пустое значение означает
# временный ключ на один запуск: после перезапуска все выданные access-токены
# перестанут проходить проверку.
JWT_PRIVATE_KEY_PATH=./configs/jwt_private_key.pem
